{
  "name": "tales-of-words-invasion",
  "private": true,
  "description": "Narrative roguelike set in the Tales of Words universe. Web app in TypeScript, packaged with Capacitor.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tow/app dev",
    "build": "pnpm --filter @tow/app build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tow/app test:e2e",
    "validate:content": "pnpm --filter @tow/sim validate",
    "sim": "pnpm --filter @tow/sim sim",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:content"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.2"
  }
}
